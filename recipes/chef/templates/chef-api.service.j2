[Unit]
Description=Chef API (uvicorn/FastAPI)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/chef/chef.env
ExecStart={{ chef_bin }} serve --host 0.0.0.0 --port 8000
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
