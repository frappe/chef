# Written for the ClickHouse stack. Read by datum.service via EnvironmentFile.
DATUM_CLICKHOUSE_HOST=127.0.0.1
DATUM_CLICKHOUSE_PORT=8123
DATUM_CLICKHOUSE_USER=datum
DATUM_CLICKHOUSE_PASSWORD={{ datum_password }}
DATUM_CLICKHOUSE_DATABASE={{ database }}
DATUM_CLICKHOUSE_TABLE={{ table }}
{% if jwt_public_key %}DATUM_JWT_PUBLIC_KEY_FILE={{ public_key_file }}
{% endif %}{% if oidc_issuer %}DATUM_OIDC_ISSUER={{ oidc_issuer }}
{% endif %}
