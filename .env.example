# Chef configuration — copy to .env and edit. Every var is prefixed CHEF_.
# All values below are the built-in dev defaults; uncomment to override.

# --- API / auth ---
CHEF_API_TOKEN=chef-dev-token
# JSON array of allowed CORS origins.
CHEF_CORS_ORIGINS=["http://localhost:5173"]

# --- jobs / streaming (Redis) ---
CHEF_REDIS_URL=redis://localhost:6379
CHEF_LOG_STREAM_TTL_SECONDS=86400

# --- data store (SQLite; bakes + images index) ---
CHEF_DATABASE_URL=sqlite:///chef.db

# --- recipes ---
# CHEF_RECIPES_DIR=recipes

# --- builder selection: docker | local | atlas ---
CHEF_DEFAULT_BUILDER=docker

# --- S3 / object store (MinIO in dev) ---
# CHEF_S3_ENDPOINT_URL=http://localhost:9000
CHEF_S3_REGION=us-east-1
CHEF_S3_BUCKET=chef-images
# CHEF_S3_ACCESS_KEY=chef
# CHEF_S3_SECRET_KEY=chef-secret
CHEF_S3_PREFIX=images

# --- Atlas backend (AtlasBuilder / AtlasPublisher, M2) ---
# CHEF_ATLAS_URL=http://atlas.localhost:8000
# CHEF_ATLAS_API_KEY=
# CHEF_ATLAS_API_SECRET=
# CHEF_ATLAS_SSH_KEY_FILE=
